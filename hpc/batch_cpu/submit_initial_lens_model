#!/bin/bash -l
#
# Initial lens model on CPU: both stages, one submission, two Python processes.
#
# WHAT THIS DOES
#   Runs `--stage=vis_lp` and then `--stage=vis_pix` as two `python3` calls in
#   one job, both with `--setup=cpu`: each analysis resolves the designated CPU
#   setup for its own model (vis_lp: JAX on the CPU, `jax_cpu_dense_fp64`;
#   vis_pix: the Numba sparse operator, `numba_cpu_sparse_fp64`) and logs it as
#   its `Setup:` line.
#
#   It used to be one `python3` call with `--use_cpu`, which turned JAX off for
#   both stages. `--setup=cpu` puts vis_lp on JAX, so the stages are now separate
#   processes: the vis_pix Nautilus pool must not fork from an interpreter that
#   has initialised JAX and its OpenMP pool (hpc/README.md, "Why two processes").
#
# WHEN TO USE IT
#   For a handful of lenses where one job per lens is simpler than a campaign.
#
# WHY THE CAMPAIGN IS STILL PREFERRED
#   The two stages want different allocations: `vis_lp` runs one JAX process and
#   spends the cores on threads; `vis_pix` runs a Nautilus pool of
#   `--number_of_cores` workers with one thread each. Here both get the same
#   SLURM allocation. The campaign, `hpc/campaign/dr1.yaml`, runs them as two
#   stages, chained lens by lens, each sized for its own work. Prefer it for
#   anything beyond a handful of lenses (see hpc/README.md).

#SBATCH -J euclid_initial_lens_model_cpu
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=ral
# NEVER add gpu here: CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs.
#SBATCH -t 18:00:00
#SBATCH --mem=64gb
#SBATCH --array=0-0
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=your.email@institution.ac.uk

# -----------------------------------------------------------------------------
# Environment
#
# Set PROJECT_PATH to this project on the HPC before submitting:
#
#   export PROJECT_PATH=/PATH/TO/LARGE_STORAGE/YOUR_USERNAME/euclid_strong_lens_modeling_pipeline
#   sbatch hpc/batch_cpu/submit_initial_lens_model
#
# This is the same location as $HPC_BASE/$PROJECT_NAME in hpc/sync.conf.
# -----------------------------------------------------------------------------
source $PROJECT_PATH/activate.sh

# `--setup=cpu` already picks the CPU rules; these make sure JAX itself never
# reaches for a GPU that was not allocated to this job.
export JAX_PLATFORM_NAME=cpu
export JAX_PLATFORMS=cpu

# Pin every linear algebra library to the CPUs SLURM actually allocated. Without
# this each library spawns one thread per physical core, and array jobs sharing
# a node oversubscribe it badly.
#
# These serve `vis_lp`; the `vis_pix` call below pins them to 1 for itself.
THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$THREADS
export MKL_NUM_THREADS=$THREADS
export OMP_NUM_THREADS=$THREADS
export VECLIB_MAXIMUM_THREADS=$THREADS
export NUMEXPR_NUM_THREADS=$THREADS
export NPROC=$THREADS

# -----------------------------------------------------------------------------
# Sample
#
# The sample is the subdirectory inside dataset/ that contains the datasets.
# -----------------------------------------------------------------------------
sample=q1_walsmley

# -----------------------------------------------------------------------------
# Dataset list
#
# Each entry is the name of a subdirectory inside dataset/$sample/.
# One array task is launched per entry, and each fits a different lens.
#
# To fit many lenses, add entries here and widen the --array directive above to
# match: three datasets means --array=0-2.
# -----------------------------------------------------------------------------
datasets=(
102018665_NEG570040238507752998
)

# -----------------------------------------------------------------------------
# Select dataset for this array task
# -----------------------------------------------------------------------------
INDEX=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$INDEX]}"

echo "=========================================="
echo "Array task : $INDEX / ${#datasets[@]}"
echo "Sample     : $sample"
echo "Dataset    : $dataset"
echo "Stage      : vis_lp (JAX CPU) then vis_pix (Numba CPU), --setup=cpu"
echo "CPUs       : $THREADS"
date

# vis_lp: JAX on the CPU, one process; `--number_of_cores=auto` resolves to 1 for
# a JAX analysis, and the threads above serve its vectorised likelihood.
python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
    --stage=vis_lp --setup=cpu --number_of_cores=auto || exit 1

# vis_pix: the Numba sparse route in a fresh process, loading the vis_lp result
# from disk. `--number_of_cores=auto` resolves to the allocated CPUs, one Nautilus
# worker each, so every thread pool is pinned to 1 before Python starts. Keep these
# pins: RAL logged "fork() called from a process already using GNU OpenMP" for a
# pooled stage (job 414150), and the finding is open.
env OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    NUMBA_NUM_THREADS=1 \
    python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
        --stage=vis_pix --setup=cpu --number_of_cores=auto

echo "Finished: $dataset"
date
