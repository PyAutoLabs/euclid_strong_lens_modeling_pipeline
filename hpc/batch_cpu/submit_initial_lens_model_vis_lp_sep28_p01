#!/bin/bash -l
#
# Initial lens model, stage 1 of 2 on CPU: the `vis_lp` search only.
#
# THIS RUN
#   The single part of the "sep28" vis_lp batch: 987 lenses of `dataset/dr1_v2_new/`, the
#   v2 A/B cut-outs delivered on 2026-09-28 (`sep28_eclipse_new_ab-segmentation.zip`,
#   1,056 dirs) that no dr1_sep1 tile covers. Selected 2026-10-01
#   (`hpc/run_manifests/dr1_v2_new_selection_20261001.csv`): 942 objects of
#   `catalogue/grades/dr1_v2_new_cutouts_needed.csv` plus 45 re-centred cut-outs whose
#   object has no dr1_sep1 tile within 1"; 48 dirs whose name is already a dr1_sep1 tile and
#   21 re-centred cut-outs within 1" of a dr1_sep1 tile were dropped as duplicates.
#   v2 grades A 114 / B 873, ordered by v2_score descending (2.99999 -> 1.500), read from
#   `hpc/run_manifests/vis_lp_sep28_20261001.txt` (task N = line N). 12 names carry the v2
#   catalogue's own `15arcsec_near_RADEC_` prefix; those cut-outs are centred on the object
#   and fit as-is.
#   Positions are finder-2.1 (`scripts/tools/rewrite_positions.py`, run 2026-10-01):
#   keep 633 / drop 59 / flag 7 / review 9 / n_lt_2 279; review and n_lt_2 tiles have no
#   positions.json and fit with no positions penalty, as in the rest batch.
#   Resources: 4 CPU / 12 GB / 18 h, %100, as the rest vis_lp
#   (`submit_initial_lens_model_vis_lp_rest_pNN`). Partition ral only.
#
# WHAT THIS DOES
#   Fits the light-profile source model (`vis_lp`) with JAX pinned to the CPU
#   backend, then exits. It does NOT fit the pixelized source; see
#   `submit_initial_lens_model_vis_lp_rest_01` for why the two stages are
#   separate processes.
#
# SUBMIT
#   hpc/sync submit cpu submit_initial_lens_model_vis_lp_sep28_p01
#
#SBATCH -J euclid_dr1_vis_lp_sep28_p01
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=ral
# NEVER add gpu here (2026-09-30): CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs; comments above that justify ral,gpu are superseded.
#SBATCH -t 18:00:00
#SBATCH --mem=12gb
#SBATCH --array=0-986%100
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export PROJECT_PATH=/mnt/ral/jnightin/active/euclid_dr1
export PYAUTO_HPC_BASE=/mnt/ral/jnightin/PyAuto

source $PROJECT_PATH/activate.sh

export JAX_PLATFORM_NAME=cpu
export JAX_PLATFORMS=cpu

THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$THREADS
export MKL_NUM_THREADS=$THREADS
export OMP_NUM_THREADS=$THREADS
export VECLIB_MAXIMUM_THREADS=$THREADS
export NUMEXPR_NUM_THREADS=$THREADS
export NPROC=$THREADS

sample=dr1_v2_new
manifest="$PROJECT_PATH/hpc/run_manifests/vis_lp_sep28_20261001.txt"
mapfile -t datasets < "$manifest"

INDEX=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$INDEX]}"

if [[ ${#datasets[@]} -ne 987 || -z "$dataset" ]]; then
    echo "ERROR: expected a 987-tile manifest and a dataset at index $INDEX" >&2
    exit 1
fi
if [[ ! -f "$PROJECT_PATH/dataset/$sample/$dataset/$dataset.fits" ]]; then
    echo "ERROR: dataset/$sample/$dataset/$dataset.fits is missing" >&2
    exit 1
fi

echo "=========================================="
echo "Array task : $INDEX / ${#datasets[@]}"
echo "Sample     : $sample"
echo "Dataset    : $dataset"
echo "Stage      : vis_lp (JAX on CPU)"
echo "CPUs       : $THREADS"
echo "Positions  : $(cat $PROJECT_PATH/dataset/$sample/$dataset/positions_meta.json 2>/dev/null || echo 'no positions_meta.json')"
date

python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
    --stage=vis_lp --number_of_cores=$THREADS

echo "Finished vis_lp: $dataset"
date
