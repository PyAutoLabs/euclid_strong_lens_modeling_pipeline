#!/bin/bash -l
#
# Starting point for a one-off CPU job: a single lens, no array, the two stages
# as two Python processes with `--setup=cpu` (vis_lp on JAX-CPU, then vis_pix on
# the Numba sparse route, which must not fork from a JAX-initialised process).
#
# Copy it, rename it, and change the `sample`, `dataset` and the `python3` lines
# to whichever script you want to run. For fitting more than one lens, do not
# copy this: run the campaign, `hpc/campaign/dr1.yaml` (see hpc/README.md). It
# runs vis_lp, vis_pix and the SED chain as separate stages through
# `hpc/batch_cpu/stage`, each with the thread/process environment it wants.
# `submit_initial_lens_model` is the array form of this single-process route.

#SBATCH -J euclid_cpu
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH -o output/output.%A.out
#SBATCH -e error/error.%A.err
#SBATCH --partition=ral
# NEVER add gpu here: CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs.
#SBATCH -t 18:00:00
#SBATCH --mem=64gb
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=your.email@institution.ac.uk

# -----------------------------------------------------------------------------
# Environment
#
# Set PROJECT_PATH to this project on the HPC before submitting:
#
#   export PROJECT_PATH=/PATH/TO/LARGE_STORAGE/YOUR_USERNAME/euclid_strong_lens_modeling_pipeline
#   sbatch hpc/batch_cpu/template
#
# This is the same location as $HPC_BASE/$PROJECT_NAME in hpc/sync.conf.
# -----------------------------------------------------------------------------
source $PROJECT_PATH/activate.sh

# `--setup=cpu` already picks the CPU rules; these make sure JAX itself never
# reaches for a GPU that was not allocated to this job.
export JAX_PLATFORM_NAME=cpu
export JAX_PLATFORMS=cpu

# Pin every linear algebra library to the CPUs SLURM actually allocated. Without
# this each library spawns one thread per physical core, and jobs sharing a node
# oversubscribe it badly.
THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=$THREADS
export MKL_NUM_THREADS=$THREADS
export OMP_NUM_THREADS=$THREADS
export VECLIB_MAXIMUM_THREADS=$THREADS
export NUMEXPR_NUM_THREADS=$THREADS
export NPROC=$THREADS

# -----------------------------------------------------------------------------
# Sample and Dataset
#
# Set sample to the subdirectory inside dataset/ and dataset to the specific lens.
# -----------------------------------------------------------------------------
sample=q1_walsmley
dataset=102018665_NEG570040238507752998

echo "=========================================="
echo "Sample  : $sample"
echo "Dataset : $dataset"
echo "CPUs    : $THREADS"
date

python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
    --stage=vis_lp --setup=cpu --number_of_cores=auto || exit 1

# The pooled vis_pix stage: one thread per Nautilus worker, pinned before Python
# starts (RAL OpenMP-fork finding, job 414150; see hpc/batch_cpu/stage).
env OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    NUMBA_NUM_THREADS=1 \
    python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
        --stage=vis_pix --setup=cpu --number_of_cores=auto

echo "Finished: $dataset"
date
