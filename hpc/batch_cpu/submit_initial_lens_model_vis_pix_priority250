#!/bin/bash -l
#
# Initial lens model, stage 2 of 2 on CPU: the `vis_pix` search (Numba sparse
# CPU, forked pool, no JAX) for the first 250 lenses of `dataset/dr1_sep1_rest/`.
#
# THIS RUN
#   Follow-up to array 350804 (`submit_initial_lens_model_vis_lp_priority250`).
#   Same manifest, `hpc/run_manifests/positions_priority_250.txt`, so array
#   task N continues the lens that task N of 350804 fitted. Each task checks
#   that exactly one completed vis_lp zip exists in `output/` before starting.
#   Submitted with `--dependency=afterany:350804`.
#
#SBATCH -J euclid_dr1_vis_pix_prio250
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=ral
# NEVER add gpu here (2026-09-30): CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs; comments above that justify ral,gpu are superseded.
#SBATCH -t 18:00:00
#SBATCH --mem=64gb
#SBATCH --array=0-249
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export PROJECT_PATH=/mnt/ral/jnightin/euclid_dr1
export PYAUTO_HPC_BASE=/mnt/ral/jnightin/PyAuto

source $PROJECT_PATH/activate.sh

THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NPROC=$THREADS

sample=dr1_sep1_rest
manifest="$PROJECT_PATH/hpc/run_manifests/positions_priority_250.txt"
mapfile -t datasets < "$manifest"

INDEX=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$INDEX]}"

if [[ ${#datasets[@]} -ne 250 || -z "$dataset" ]]; then
    echo "ERROR: expected a 250-tile manifest and a dataset at index $INDEX" >&2
    exit 1
fi
shopt -s nullglob
vis_lp_zips=("$PROJECT_PATH/output/$sample/$dataset/initial_lens_model/vis_lp"/*.zip)
if [[ ${#vis_lp_zips[@]} -ne 1 ]]; then
    echo "ERROR: expected one completed vis_lp zip for $dataset, found ${#vis_lp_zips[@]}" >&2
    exit 1
fi

echo "=========================================="
echo "Array task : $INDEX / ${#datasets[@]}"
echo "Sample     : $sample"
echo "Dataset    : $dataset"
echo "Stage      : vis_pix (Numba CPU sparse, no JAX)"
echo "Pool procs : $THREADS"
echo "vis_lp seed: ${vis_lp_zips[0]}"
date

python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
    --stage=vis_pix --use_cpu --number_of_cores=$THREADS --iterations_per_quick_update=1000

echo "Finished vis_pix: $dataset"
date
