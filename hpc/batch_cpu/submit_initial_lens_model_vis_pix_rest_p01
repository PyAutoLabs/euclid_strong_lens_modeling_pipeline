#!/bin/bash -l
#
# Initial lens model, stage 2 of 2 on CPU: the `vis_pix` search (Numba sparse
# CPU, forked pool, no JAX) for part 01 of 4 of the "rest" batch of 3,779 lenses of
# `dataset/dr1_sep1_rest/`.
#
# THIS RUN
#   Follow-up to vis_lp array 375700 (`submit_initial_lens_model_vis_lp_rest_p01`).
#   Same manifest, `hpc/run_manifests/vis_lp_rest_20260930_part01.txt` (945 tiles), so
#   array task N continues the lens that task N of 375700 fitted. Submitted by
#   `hpc/batch_cpu/submit_vis_pix_rest_chain.sh` on RAL (idempotent, re-runnable):
#     - one array over the indices whose vis_lp task had COMPLETED at submit time
#       (no dependency);
#     - one single-task array (`--array=N`) per still-queued index N, with
#       `--dependency=afterok:375700_N --kill-on-invalid-dep=yes`, so it starts when
#       vis_lp task N succeeds and is cancelled if it fails or times out.
#   (aftercorr never fires on this slurmctld: completed task records are purged
#   after MinJobAge=300 s; see wiki/project/2026-09-29-vis-pix-v2grade-overnight.md.)
#   Each task also checks that exactly one completed vis_lp zip exists in
#   `output/` before starting (a vis_lp task can end COMPLETED without a zip when
#   the python crashes, since the script's last command is an echo); a vis_pix
#   search that already completed is loaded, not re-fitted.
#   Resources: 8 CPU / 16 GB / 24 h, as vis_pix_v2g. Its 3,167 COMPLETED tasks
#   (sparse route): elapsed p50 1.3 h, p99 2.5 h, max 18.2 h; MaxRSS p50 6.5 GB,
#   p99 6.8 GB. Partition ral,gpu (gpu nodes run CPU-only work without --gres).
#
# SUBMIT
#   bash hpc/batch_cpu/submit_vis_pix_rest_chain.sh [--dry-run]   (on RAL, all 4 parts)
#   or by hand: sbatch --array=<indices> submit_initial_lens_model_vis_pix_rest_p01
#
#SBATCH -J euclid_dr1_vis_pix_rest_p01
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=ral
#SBATCH -t 24:00:00
#SBATCH --mem=16gb
#SBATCH --array=0-944%60
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

export PROJECT_PATH=/mnt/ral/jnightin/euclid_dr1
export PYAUTO_HPC_BASE=/mnt/ral/jnightin/PyAuto

source $PROJECT_PATH/activate.sh

THREADS=$SLURM_CPUS_PER_TASK
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export NPROC=$THREADS

sample=dr1_sep1_rest
manifest="$PROJECT_PATH/hpc/run_manifests/vis_lp_rest_20260930_part01.txt"
mapfile -t datasets < "$manifest"

INDEX=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$INDEX]}"

if [[ ${#datasets[@]} -ne 945 || -z "$dataset" ]]; then
    echo "ERROR: expected a 945-tile manifest and a dataset at index $INDEX" >&2
    exit 1
fi
shopt -s nullglob
vis_lp_zips=("$PROJECT_PATH/output/$sample/$dataset/initial_lens_model/vis_lp"/*.zip)
if [[ ${#vis_lp_zips[@]} -ne 1 ]]; then
    echo "ERROR: expected one completed vis_lp zip for $dataset, found ${#vis_lp_zips[@]}" >&2
    exit 1
fi

echo "=========================================="
echo "Array task : $INDEX / ${#datasets[@]}"
echo "Sample     : $sample"
echo "Dataset    : $dataset"
echo "Stage      : vis_pix (Numba CPU sparse, no JAX)"
echo "Pool procs : $THREADS"
echo "Node       : $(hostname) (partition $SLURM_JOB_PARTITION)"
echo "vis_lp seed: ${vis_lp_zips[0]}"
date

python3 $PROJECT_PATH/scripts/initial_lens_model.py --sample=$sample --dataset=$dataset \
    --stage=vis_pix --use_cpu --number_of_cores=$THREADS --iterations_per_quick_update=1000

echo "Finished vis_pix: $dataset"
date
