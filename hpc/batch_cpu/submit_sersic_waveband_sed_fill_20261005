#!/bin/bash -l
#
# Copy of submit_sersic_waveband_missing for the 2026-10-05 SED gap-fill
# (hpc/run_manifests/sed_fill_20261005/README.txt). Differences: wall 10 h, no mail, and
# poisoned Nautilus checkpoints are moved aside instead of resumed:
#   * before the chain, every band fit under output_sed/<sample>/<tile>/sersic_lens_model/
#     that has an unfinished files/search_internal (no .completed) has it RENAMED (never
#     deleted) to search_internal.poisoned_<timestamp>, so the band starts fresh rather
#     than resuming the checkpoint that crashed or hung it. The earlier retries died after
#     ~25 s with Nautilus "Singular matrix" (bounding-ellipsoid LinAlgError) because they
#     resumed exactly that checkpoint (388372: 24 / 50 FAILED this way).
#   * the chain is retried up to 3 times in-job: an attempt that dies with "Singular
#     matrix" has that band's search_internal renamed the same way, and the next attempt
#     starts it fresh (Nautilus seed=None -> new draw).
#
# Multi-wavelength SED chain (VIS Sersic fit + one Sersic fit per NIR/DECam
# band, JAX on CPU) for every catalogue tile whose SED is not complete in output_sed/
# per the final audit (job 396903, inspect/sed_audit_final_20261005).
#
# THIS RUN
#   One array per list, MANIFEST=sed_fill_20261005/<sample>_<status>.txt, SAMPLE=<sample>:
#     dr1_sep1_rest_partial.txt 2,512   dr1_sep1_rest_none.txt 38
#     dr1_v2_new_partial.txt       50   dr1_v2_new_none.txt   676
#   (lists built by hpc/run_manifests/sed_fill_20261005/build.py on RAL.)
#   Idempotent per task: a tile whose SED is already complete exits 0 at once, and the
#   chain itself cache-skips every band that already has a zip.
#   Resources: 8 CPU / 16 GB (MaxRSS ~3 GB), wall 10 h.
#
# SUBMIT (on RAL, from hpc/batch_cpu so the -o/-e paths resolve) -- exact commands in
#   hpc/run_manifests/sed_fill_20261005/README.txt, e.g.
#   sbatch --export=ALL,SAMPLE=dr1_v2_new,MANIFEST=sed_fill_20261005/dr1_v2_new_none.txt \
#       --array=0-675%40 submit_sersic_waveband_sed_fill_20261005
#
#SBATCH -J euclid_dr1_sed_fill
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=ral
# NEVER add gpu here (2026-09-30): CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs.
#SBATCH -t 10:00:00
#SBATCH --mem=16gb
#SBATCH --mail-type=NONE
#SBATCH --mail-user=james.w.nightingale@durham.ac.uk

set -euo pipefail

export PROJECT_PATH=/mnt/ral/jnightin/euclid_dr1
export PYAUTO_HPC_BASE=/mnt/ral/jnightin/PyAuto
export PYAUTO_OUTPUT_DIR=output_sed

source "$PROJECT_PATH/activate.sh"

sample="${SAMPLE:?SAMPLE not set: --export=ALL,SAMPLE=dr1_sep1_rest,MANIFEST=...}"
manifest="$PROJECT_PATH/hpc/run_manifests/${MANIFEST:?MANIFEST not set}"
mapfile -t datasets < "$manifest"

index=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$index]:-}"
threads=$SLURM_CPUS_PER_TASK

if [[ -z "$dataset" ]]; then
    echo "ERROR: no dataset at index $index of $manifest (${#datasets[@]} tiles)" >&2
    exit 1
fi

dataset_fits="$PROJECT_PATH/dataset/$sample/$dataset/$dataset.fits"
sed_dir="$PROJECT_PATH/$PYAUTO_OUTPUT_DIR/$sample/$dataset"

# Skip when every <BAND>_BGSUB HDU of the cut-out already has a completed band zip
# (same rule as scripts/tools/sed_completeness.py).
expected=$(python3 - "$dataset_fits" <<'EOF'
import sys
from astropy.io import fits
with fits.open(sys.argv[1], lazy_load_hdus=True) as h:
    print(" ".join(x.name.replace("_BGSUB", "").lower() for x in h if x.name.endswith("_BGSUB")))
EOF
)
missing=()
shopt -s nullglob
for band in $expected; do
    z=("$sed_dir/sersic_lens_model/$band"/*.zip "$sed_dir/sersic_lens_model/$band"/*/.completed)
    [[ ${#z[@]} -gt 0 ]] || missing+=("$band")
done
if [[ -n "$expected" && ${#missing[@]} -eq 0 ]]; then
    echo "SKIP: $dataset SED already complete ($expected)"
    exit 0
fi
echo "Bands expected: $expected"
echo "Bands missing : ${missing[*]}"

# Seed output_sed with the completed VIS result so the chain cache-skips vis_lp.
seed_source="$PROJECT_PATH/output/$sample/$dataset/initial_lens_model/vis_lp"
seed_target="$sed_dir/initial_lens_model/vis_lp"
mkdir -p "$seed_target"
seed_zips=("$seed_source"/*.zip)
if [[ ${#seed_zips[@]} -ne 1 ]]; then
    echo "ERROR: expected one completed vis_lp seed for $dataset, found ${#seed_zips[@]}" >&2
    exit 1
fi
existing=("$seed_target"/*.zip)
if [[ ${#existing[@]} -eq 0 ]]; then
    cp -a "${seed_zips[0]}" "$seed_target/"
fi
# Move aside every unfinished band search (poisoned checkpoint from a crash or TIMEOUT).
for search_internal in "$sed_dir"/sersic_lens_model/*/*/files/search_internal; do
    fit_dir="${search_internal%/files/search_internal}"
    [[ -e "$fit_dir/.completed" ]] && continue
    poisoned="$search_internal.poisoned_$(date +%Y%m%dT%H%M%S)"
    mv "$search_internal" "$poisoned"
    echo "MOVED ASIDE: unfinished $search_internal -> $(basename "$poisoned")"
done
shopt -u nullglob

echo "Array task : $index / ${#datasets[@]}"
echo "Sample     : $sample"
echo "Dataset    : $dataset"
echo "Manifest   : $manifest"
echo "Output dir : $PYAUTO_OUTPUT_DIR"
date

env JAX_PLATFORM_NAME=cpu JAX_PLATFORMS=cpu \
    python3 -c 'import jax; raise SystemExit(0 if jax.default_backend() == "cpu" else 1)'

run_chain() {
env JAX_PLATFORM_NAME=cpu \
    JAX_PLATFORMS=cpu \
    OPENBLAS_NUM_THREADS="$threads" \
    MKL_NUM_THREADS="$threads" \
    OMP_NUM_THREADS="$threads" \
    VECLIB_MAXIMUM_THREADS="$threads" \
    NUMEXPR_NUM_THREADS="$threads" \
    NPROC="$threads" \
    python3 "$PROJECT_PATH/scripts/sersic_lens_model_waveband.py" \
        --sample="$sample" --dataset="$dataset" --number_of_cores="$threads"
}

tag="${SLURM_ARRAY_JOB_ID:-$SLURM_JOB_ID}_${index}"
attempt_log="$PROJECT_PATH/hpc/batch_cpu/output/sed_fill_attempt.${tag}.log"
for attempt in 1 2 3; do
    echo "=== chain attempt $attempt ($(date))"
    set +e
    run_chain > >(tee "$attempt_log") 2> >(tee "$attempt_log.err" >&2)
    rc=$?
    set -e
    sleep 2
    [[ $rc -eq 0 ]] && break
    if grep -q "Singular matrix" "$attempt_log.err"; then
        band_dir=$(grep -ao "The output path of this fit is [^ ]*" "$attempt_log" | tail -1 | awk '{print $NF}')
        if [[ -n "$band_dir" && -d "$band_dir/files/search_internal" ]]; then
            mv "$band_dir/files/search_internal" "$band_dir/files/search_internal.poisoned_$(date +%Y%m%dT%H%M%S)"
            echo "RETRY: Singular matrix in $band_dir -- search_internal moved aside, restarting fresh"
            continue
        fi
    fi
    echo "ERROR: chain failed rc=$rc (attempt $attempt), not a retryable Singular-matrix crash" >&2
    rm -f "$attempt_log" "$attempt_log.err"
    exit $rc
done
rm -f "$attempt_log" "$attempt_log.err"
[[ $rc -eq 0 ]] || { echo "ERROR: chain failed after 3 attempts" >&2; exit $rc; }

echo "Finished: $dataset"
date
